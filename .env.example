# 이 파일을 .env로 복사해서 내 컴퓨터용 값을 넣으세요. .env는 GitHub에 올라가지 않습니다.
# Render에서는 이 값들을 render.yaml이 자동으로 채웁니다.

# 로컬 PostgreSQL 주소 (예시 값입니다)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/baby_rental_level2"

# 백엔드 포트
PORT=4000

# 프론트엔드 주소 (쉼표로 여러 개 가능)
FRONTEND_ORIGIN="http://localhost:3000"

# --- 가상 데이터 초기화 (Level 2 데모 서버에서만 켭니다) ---
# true 일 때만 POST /admin/reset-demo 가 동작합니다. 켜지 않으면 403.
ALLOW_DEMO_RESET=false
# 초기화 요청 헤더(x-reset-token)와 같아야 하는 비밀 값. 직접 정해서 .env / Render 환경변수에만 넣으세요.
DEMO_RESET_TOKEN=
